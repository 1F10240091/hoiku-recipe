# 開発用バックエンド環境変数（backend/.env として使用）
ENVIRONMENT=development

# DB 接続（開発: SQLite / 本番: PostgreSQL）
DATABASE_URL=sqlite:///./hoiku_recipe.db

# 開発専用の例。本番では64桁以上のランダム値を必ず設定すること。
JWT_SECRET_KEY=development-only-change-before-deployment

# 許可するオリジン（開発用。本番では実際のHTTPSフロントエンドURLへ変更）
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Gemini API（Google AI Studio）
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_MAX_PAGES=5

# 信頼するリバースプロキシのIP（必要な場合だけ設定。X-Forwarded-Forの偽装防止）
TRUSTED_PROXY_IPS=[]

# レート制限（ログイン・登録へのブルートフォース対策）
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_REQUESTS=5
RATE_LIMIT_WINDOW_SECONDS=60
