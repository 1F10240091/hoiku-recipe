# バックエンド環境変数（コピーして .env にリネーム）

# DB 接続（開発: SQLite / 本番: PostgreSQL）
DATABASE_URL=sqlite:///./hoiku_recipe.db

# JWT 秘密鍵（本番では必ず強力な値に変更してください）
JWT_SECRET_KEY=change-me-in-production

# 許可するオリジン（JSON 配列）
CORS_ORIGINS=["http://localhost:3000"]

# AI 献立生成（OpenAI API）
# API キーを設定すると AI による生成、未設定ならルールベースで選定
# ※ キーはサーバー側でのみ使用する。NEXT_PUBLIC_ を付けない・コミットしない。
# AIプロバイダー（gemini または openai）
AI_PROVIDER=gemini

# Gemini API（Google AI Studio）
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# OpenAI APIを使う場合
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_PAGES=5

# レート制限（ログイン・登録へのブルートフォース対策）
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_REQUESTS=5
RATE_LIMIT_WINDOW_SECONDS=60
