# バックエンド環境変数（コピーして .env にリネーム）

# DB 接続（開発: SQLite / 本番: PostgreSQL）
DATABASE_URL=sqlite:///./hoiku_recipe.db

# JWT 秘密鍵（本番では必ず強力な値に変更してください）
JWT_SECRET_KEY=change-me-in-production

# 許可するオリジン（JSON 配列）
CORS_ORIGINS=["http://localhost:3000"]

# AI 献立生成（Xiaomi MiMo・OpenAI 互換 API）
# API キーを設定すると AI による選定、未設定ならルールベースで選定
# ※ キーはサーバー側でのみ使用する。NEXT_PUBLIC_ を付けない・コミットしない。
AI_API_KEY=
AI_BASE_URL=https://api.xiaomimimo.com/v1
AI_MODEL=mimo-v2.6-pro

# 献立表の AI 読み取り（マルチモーダル）
# 画像入力に対応: mimo-v2.6-flash / mimo-v2.6-pro / mimo-v2.6-pro-ultraspeed
AI_OCR_MODEL=mimo-v2.6-flash
AI_OCR_MAX_PAGES=5

# レート制限（ログイン・登録へのブルートフォース対策）
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_REQUESTS=5
RATE_LIMIT_WINDOW_SECONDS=60
