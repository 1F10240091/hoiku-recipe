{
  "name": "hoiku-recipe",
  "version": "0.1.0",
  "private": true,
  "description": "保育園児の親向け献立自動生成アプリ",
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "setup": "npm install && npm run setup:backend",
    "setup:backend": "cd backend && python -m venv .venv && .venv\\Scripts\\pip install -r requirements.txt",
    "dev": "node scripts/dev.js",
    "dev:frontend": "npm run dev --workspace frontend -- -H 127.0.0.1",
    "dev:backend": "cd backend && .venv\\Scripts\\uvicorn app.main:app --host 127.0.0.1 --port 8000",
    "start:frontend": "npm run start --workspace frontend -- -H 127.0.0.1",
    "start:frontend:production": "npm run start --workspace frontend -- -H 0.0.0.0",
    "build": "npm run build --workspace frontend",
    "lint": "npm run lint --workspace frontend"
  },
  "engines": {
    "node": ">=18.17.0"
  }
}
